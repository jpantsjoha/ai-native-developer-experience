{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "data-warehouse": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@example/mcp-data-server", "--project", "${GCP_PROJECT_ID}"],
      "env": {
        "GCP_PROJECT_ID": "your-project-id",
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}"
      }
    },
    "official-docs": {
      "type": "stdio",
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@latest"],
      "env": {}
    },
    "knowledge-base": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@example/mcp-knowledge-server", "--site", "${KB_SITE}"],
      "env": {
        "KB_SITE": "your-site-or-space",
        "KB_TOKEN": "${KB_TOKEN}"
      }
    }
  }
}
