#!/usr/bin/env bash
#
# Pre-commit hook: Markdown lint gate, then the independent review gate.
#
# 1. Markdown lint — mirrors the CI "Markdown Lint" job (.github/workflows/dx-validation.yml),
# which runs markdownlint-cli2 with the repo's .markdownlint.json config.
# Lints only the markdown files staged for this commit, so it stays fast.
# 2. Review gate (opt-in) — scripts/review-gate.sh uses the explicitly configured
#    REVIEW_GATE_LANE and REVIEW_GATE_MODEL. No automatic provider fallback.
#    Off by default; enable with REVIEW_GATE=async|block or git config review.gate.
#    Async retains advisory history only. Blocking mode requires a complete current
#    PASS; unavailable, failed or conditional review never approves.
#    See skills/pr-reviewer/SKILL.md for the fresh-context Claude/Council adapter.
#
# This hook is version-controlled under .githooks/ so it travels with the repo.
# To activate it after cloning, run once:
#
#     git config core.hooksPath .githooks
#
set -euo pipefail

# Collect staged markdown files (Added, Copied, Modified, Renamed).
# NUL-delimited read so it stays correct for paths with spaces, and portable
# back to bash 3.2 (macOS default) which lacks `mapfile`.
STAGED_MD=()
while IFS= read -r -d '' f; do
  STAGED_MD+=("$f")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.md' '*.markdown')

if [ "${#STAGED_MD[@]}" -gt 0 ]; then

echo "pre-commit: linting ${#STAGED_MD[@]} staged markdown file(s)..."

# Prefer markdownlint-cli2 (what CI uses); fall back to markdownlint-cli;
# last resort, run cli2 via npx if Node is available.
if command -v markdownlint-cli2 >/dev/null 2>&1; then
  LINT=(markdownlint-cli2)
elif command -v markdownlint >/dev/null 2>&1; then
  LINT=(markdownlint)
elif command -v npx >/dev/null 2>&1; then
  LINT=(npx --yes markdownlint-cli2)
else
  echo "pre-commit: ERROR - no markdown linter found." >&2
  echo "  Install one of:" >&2
  echo "    npm install -g markdownlint-cli2   # matches CI" >&2
  echo "    npm install -g markdownlint-cli" >&2
  exit 1
fi

if ! "${LINT[@]}" "${STAGED_MD[@]}"; then
  echo "" >&2
  echo "pre-commit: markdown lint failed. Fix the issues above and re-stage, or" >&2
  echo "            bypass intentionally with: git commit --no-verify" >&2
  exit 1
fi

echo "pre-commit: markdown lint passed."
fi

# ── Independent review gate (a fresh context reviews the staged diff) ─────
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
GATE="${REVIEW_GATE:-$(git config --get review.gate 2>/dev/null || echo off)}"
if [ "$GATE" != off ] && [ -x "$REPO_ROOT/scripts/review-gate.sh" ]; then
  REVIEW_GATE="$GATE" bash "$REPO_ROOT/scripts/review-gate.sh" --staged || exit $?
fi
