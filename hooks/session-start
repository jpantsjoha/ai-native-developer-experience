#!/usr/bin/env bash
# SessionStart hook for the join-the-team plugin (Claude Code).
#
# Injects the using-the-harness orientation into the model's context at session
# start, after clear, and after compaction. The full skill (~6 KB) is injected only
# where it earns its context cost: a project that has adopted the operating model
# (docs/operating-model/PROJECT-OPERATING-PROFILE.md exists) or when
# JOIN_THE_TEAM_ORIENTATION=full. Everywhere else a short pointer is injected so the
# harness stays discoverable without taxing every session. JOIN_THE_TEAM_ORIENTATION=pointer
# forces the short form; =off injects nothing.
#
# Extensionless on purpose: Claude Code's Windows auto-detection prepends
# "bash" to commands containing .sh. Requires bash on PATH; if bash is absent
# the hook fails and the plugin degrades to skill discovery without injection.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read through whichever discovery path survived installation. `skills/` is the
# canonical directory and the Agent Plugins fixed location; `.agents/skills/` is
# the alias some runners discover natively. Installers drop one or the other:
# Codex's install cache drops `skills/`, so never depend on a single path.
skill_content=""
for skills_dir in "${PLUGIN_ROOT}/skills" "${PLUGIN_ROOT}/.agents/skills"; do
    candidate="${skills_dir}/using-the-harness/SKILL.md"
    if [ -r "$candidate" ]; then
        skill_content=$(cat "$candidate")
        break
    fi
done
if [ -z "$skill_content" ]; then
    skill_content="Error reading using-the-harness skill: not found under ${PLUGIN_ROOT}/skills or ${PLUGIN_ROOT}/.agents/skills"
fi

# Escape for JSON embedding via bash parameter substitution (single C-level
# pass per pattern, not a character loop).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Decide how much to inject. Adopted projects get the full orientation; others a pointer.
orientation="${JOIN_THE_TEAM_ORIENTATION:-auto}"
profile=""
for candidate in "docs/operating-model/PROJECT-OPERATING-PROFILE.md" "PROJECT-OPERATING-PROFILE.md"; do
    [ -f "${PWD}/${candidate}" ] && { profile="$candidate"; break; }
done
case "$orientation" in
    off) exit 0 ;;
    full) : ;;
    pointer) skill_content="join-the-team harness installed (skills discovered on disk). This project has no operating-model profile, so the full orientation was not injected. Before consequential work run the using-the-harness skill (classify risk R0-R3, route through its skill table); run join-the-team:bootstrap to adopt the operating model." ;;
    *) if [ -z "$profile" ]; then skill_content="join-the-team harness installed (skills discovered on disk). This project has no operating-model profile, so the full orientation was not injected. Before consequential work run the using-the-harness skill (classify risk R0-R3, route through its skill table); run join-the-team:bootstrap to adopt the operating model."; fi ;;
esac

skill_escaped=$(escape_for_json "$skill_content")
session_context="<EXTREMELY_IMPORTANT>\nYou are working inside a team operating harness.\n\n**Below is the full content of your 'join-the-team:using-the-harness' skill - your orientation to the operating contract and skill routing. For all other skills, use the 'Skill' tool:**\n\n${skill_escaped}\n</EXTREMELY_IMPORTANT>"

# Emit the SessionStart payload in the shape the current runner consumes.
# printf, not heredoc (bash 5.3+ heredoc hang, obra/superpowers#571).
# - Claude Code sets CLAUDE_PLUGIN_ROOT and expects nested
#   hookSpecificOutput.additionalContext.
# - Other runners (agy/Antigravity, Copilot-style) consume the SDK-standard
#   top-level additionalContext.
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
